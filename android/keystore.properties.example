# Android App Signing Configuration
# This file contains sensitive information - NEVER commit it to git!
#
# SETUP INSTRUCTIONS:
# 1. Generate a keystore:
#    keytool -genkey -v -keystore release.keystore \
#      -keyalg RSA -keysize 2048 -validity 10000 \
#      -alias ground-ops
#
# 2. Copy this file to: keystore.properties
# 3. Fill in the values below
# 4. Move release.keystore to: android/
# 5. keystore.properties is already in .gitignore
#
# SECURITY:
# - Store your keystore password securely (password manager)
# - Never share keystore or password with team
# - Use GitHub Secrets for CI/CD automated builds

# Path to the keystore file (relative to android/ directory)
storeFile=../release.keystore

# Password for the keystore file
storePassword=your_store_password_here

# Alias of the key (from keytool -keyalias)
keyAlias=ground-ops

# Password for the private key
keyPassword=your_key_password_here
